{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hunterground.io/ctf-archive/schemas/competition.schema.json",
    "title": "Competition",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "country",
      "description",
      "status",
      "references"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "country": {
        "const": "ID"
      },
      "organizer": {
        "type": [
          "string",
          "null"
        ]
      },
      "website": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri"
      },
      "description": {
        "type": "string"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "established_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1900,
            "maximum": 2100
          },
          "recurring": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "status": {
        "enum": [
          "active",
          "inactive",
          "unknown"
        ]
      },
      "references": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
  