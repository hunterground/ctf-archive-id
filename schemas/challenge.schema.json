{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hunterground.io/ctf-archive/schemas/challenge.schema.json",
    "title": "Challenge",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "slug",
      "category",
      "original_category",
      "difficulty",
      "description",
      "author",
      "provenance",
      "licensing",
      "preservation",
      "references"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[0-9]{3,}-[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "original_category": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": {
        "type": "string"
      },
      "difficulty": {
        "type": "object",
        "required": [
          "value",
          "source"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "source": {
            "enum": [
              "organizer",
              "archive_curator",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      },
      "author": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "team": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "provenance": {
        "type": "object",
        "required": [
          "archive_id",
          "repository",
          "commit",
          "original_path",
          "source_type"
        ],
        "properties": {
          "archive_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "git",
              "website",
              "download",
              "manual",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      },
      "licensing": {
        "type": "object",
        "required": [
          "declared_license",
          "redistribution",
          "attribution_required",
          "attribution"
        ],
        "properties": {
          "declared_license": {
            "type": [
              "string",
              "null"
            ]
          },
          "redistribution": {
            "enum": [
              "permitted",
              "prohibited",
              "unknown"
            ]
          },
          "attribution_required": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "preservation": {
        "type": "object",
        "required": [
          "original_structure",
          "modified",
          "checksum_verified"
        ],
        "properties": {
          "original_structure": {
            "type": "boolean"
          },
          "modified": {
            "type": "boolean"
          },
          "checksum_verified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "references": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
  