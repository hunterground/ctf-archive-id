{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunterground.io/ctf-archive/schemas/archive.schema.json",
  "title": "Archive source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "source",
    "maintainer",
    "content_types",
    "verification",
    "licensing",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "owner", "repository", "branch", "commit"],
      "properties": {
        "type": {
          "enum": [
            "git",
            "github",
            "gitlab",
            "gitea",
            "website",
            "download",
            "other"
          ]
        },
        "url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "owner": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] }
      }
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "enum": ["person", "team", "organization", "unknown"]
        },
        "name": { "type": ["string", "null"] },
        "url": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    },
    "competition_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        { "type": "null" }
      ]
    },
    "edition_year": {
      "anyOf": [
        { "type": "integer", "minimum": 1900, "maximum": 2100 },
        { "type": "null" }
      ]
    },
    "round_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        { "type": "null" }
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "enum": ["public", "private", "restricted", "unknown"]
        },
        "access_date": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      }
    },
    "content_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "challenge_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_checked"],
      "properties": {
        "status": {
          "enum": [
            "discovered",
            "partially_verified",
            "verified",
            "unavailable",
            "unknown"
          ]
        },
        "last_checked": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      }
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_license", "redistribution"],
      "properties": {
        "declared_license": { "type": ["string", "null"] },
        "redistribution": {
          "enum": ["permitted", "prohibited", "unknown"]
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reference"
      }
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  }
}
