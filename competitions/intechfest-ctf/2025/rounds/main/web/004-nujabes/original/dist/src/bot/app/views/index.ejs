<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Champloo</title>
    <link href="bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="style.css" />
    <style>
      .audio-player {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: rgba(0, 0, 0, 0.7);
        padding: 1rem;
        border: 2px solid #ff0000;
        border-radius: 0;
      }
      .audio-player label {
        font-size: 0.9rem;
        color: white;
      }
      .audio-player2 {
        position: absolute;
        bottom: 1rem;
        right: 1rem;
        background: rgba(0, 0, 0, 0.7);
        padding: 1rem;
        border: 2px solid #ff0000;
        border-radius: 0;
      }
      .audio-player2 label {
        font-size: 0.9rem;
        color: white;
        display: block;
        margin-bottom: 0.5rem;
      }
    </style>
  </head>
  <body
    class="bg-dark text-white d-flex align-items-center justify-content-center vh-100 persona-bg"
  >
    <div class="text-center">
      <h1 id="personaTitle" class="persona-title mb-4"></h1>
      <div class="position-relative mb-3">
        <input
          type="text"
          class="form-control mb-0"
          id="urlInput"
          style="position: absolute; opacity: 0; z-index: -1"
          autocomplete="off"
        />
        <input
          type="text"
          class="form-control persona-fake-input"
          id="fakeInput"
          autocomplete="off"
          placeholder="Enter URL or name..."
        />
      </div>
      <!-- csrf token -->
      <input type="hidden" id="csrfToken" value="<%= csrfToken %>" />
      <button class="btn persona-btn" id="visitBtn">Visit</button>
      <div
        id="statusModal"
        class="modal fade show"
        tabindex="-1"
        style="display: none"
        aria-modal="true"
        role="dialog"
      >
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content bg-dark text-white border-danger">
            <div class="modal-header border-bottom border-danger">
              <h5 class="modal-title text-danger">⚔ x-champloo-loading</h5>
            </div>
            <div class="modal-body">
              <p id="modalStatus">x-champloo-initializing</p>
              <div class="progress mt-3">
                <div
                  id="modalProgressBar"
                  class="progress-bar progress-bar-striped progress-bar-animated bg-danger"
                  style="width: 25%"
                ></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="audio-player">
      <!-- flac-version: https://www.mediafire.com/file/wlbolzdafy2bqsi/HOR-023_Luv%28sic%29_Part_2_%28FLAC%29.rar/file  -->
      <label>🎵 Luv(sic) Part 2</label>
      <audio id="beneathTheMask" src="luvp2.mp3" loop controls></audio>

      <!-- part2 > part1 fr fr -->
      <label>🎶 Luv(sic) Part 1</label>
      <audio id="instrumental" src="luvp1.mp3" loop controls></audio>
    </div>

    <!-- want to listen more banger?  -->
     <!-- https://www.youtube.com/watch?v=8PsG3ycLx3o&list=RD8PsG3ycLx3o&start_radio=1&rv=qXGY42C96sw -->
    <div class="audio-player2">
      <label>🎵 You dont have enemy</label>
      <audio id="colorYourNight" src="aru.mp3" loop controls></audio>
    </div>

    <audio id="click-sfx" src="click.mp3"></audio>

    <script src="index.js"></script>
  </body>
</html>
