html(lang="en")
    head
        meta(charset="UTF-8")
        title The Aurum Ledger
        meta(name="viewport" content="width=device-width, initial-scale=1, user-scalable=no")
        link(rel="icon" href="/static/images/favicon.png")
        link(href="/static/css/bootstrap.min.css" rel="stylesheet")
        link(rel="stylesheet" href="/static/css/main.css")
    body
        .clouds
            .main__wrapper
                h1 The Aurum Ledger
                aside
                    div
                        .issue Issue #256
                        .date Friday, 29 March, 2069
                        .edition
                            a(href="/feedback") Feedback Submit
                article#article
                    table.table.table-dark(border="3")
                        center
                            img.list_logo(src="/static/images/gold_coins.svg")
                        thead
                            tr
                                th(scope="col") #
                                th(scope="col") Comment
                                th(scope="col") Submitted at
                        tbody
                            if feedback !== undefined
                                each item in feedback
                                    tr
                                        th(scope="row")= item.id
                                        //- Unescaped output to preserve the challenge vulnerability
                                        td!= item.comment
                                        td= item.created_at